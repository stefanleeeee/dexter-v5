# Copy to .env. Environment variables override this local file.
GROQ_API_KEY=YOUR_GROQ_API_KEY
HOST=0.0.0.0
PORT=3333

# Obtain the official local v5_6_ru.pt first; v4_ru remains available for rollback.
TTS_MODEL=v5_6_ru
TTS_VOICE=aidar
TTS_NORMALIZE_EN=true

# Streaming enabled for length-fix verification; false restores full-response mode.
LLM_STREAMING=true

LLM_MAX_COMPLETION_TOKENS=2048

LLM_REASONING_EFFORT=low

LLM_INCLUDE_REASONING=false

# RAM-only dialogue; whole completed turns, conservative token estimate.
DIALOG_MEMORY_ENABLED=true
DIALOG_MEMORY_MAX_TURNS=6
DIALOG_MEMORY_MAX_TOKENS=1500

# Follow-up v1: opens only after capability + matching fresh capture READY.
# Legacy firmware remains wake-word-only; false restores the previous behavior.
DIALOG_FOLLOWUP_ENABLED=true
DIALOG_FOLLOWUP_TIMEOUT_S=12
